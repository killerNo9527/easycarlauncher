<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- 自上而下加深一点，卡片才有「面」的感觉；纯色在深色壁纸上会发灰 -->
    <gradient
        android:angle="270"
        android:endColor="@color/card_bg_bottom"
        android:startColor="@color/card_bg_top"
        android:type="linear" />
    <corners android:radius="@dimen/home_card_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/card_stroke" />
</shape>
