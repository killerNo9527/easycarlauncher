<?xml version="1.0" encoding="utf-8"?>
<!--
  地图卡底（覆盖层下面的那一层）：
  覆盖层窗口有 1~2 帧的挂载延迟，这层底色负责在空档里撑住视觉，不让卡片塌陷成黑洞。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="45"
        android:startColor="@color/map_card_top"
        android:centerColor="@color/map_card_center"
        android:endColor="@color/map_card_bottom"
        android:type="linear" />
    <corners android:radius="@dimen/home_card_corner_radius" />
    <stroke
        android:width="1dp"
        android:color="@color/card_stroke" />
</shape>
