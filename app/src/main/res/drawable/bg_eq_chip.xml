<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A313B" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#3FA9F5" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1B3A4A" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#35C6F4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E232B" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#2E3640" />
        </shape>
    </item>
</selector>
