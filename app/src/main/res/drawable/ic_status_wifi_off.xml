<?xml version="1.0" encoding="utf-8"?>
<!--
  状态栏 Wi-Fi · 已关闭：浅灰弧线 + 红色叉。

  为什么从「斜杠」改成「红叉」：
    斜杠在 24dp 上只是一道细线，Wi-Fi 和蓝牙同时关掉时两根斜杠长得一模一样，
    并排看过去分不清谁是谁。红叉有两点好处 —— ① 颜色是全状态栏唯一的红，
    「关 = 红叉」一眼能读出来；② 叉是两条线、重心比斜杠稳，即使图标本体很淡，
    也能看出这一格"被划掉了"而不是"画歪了"。

  为什么本体用 status_icon_faint 而不是继续靠 alpha 压：
    这一档要的是"浅但清楚"，alpha 0.5 会把弧线压到和背景几乎同色；
    而红叉又不能跟着一起变淡（alpha 是整 View 生效的），所以颜色写进矢量图，
    ImageView 不再挂 app:tint。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@color/status_icon_faint"
        android:pathData="M12,17.7 a1.35,1.35 0 1,1 0,2.7 a1.35,1.35 0 1,1 0,-2.7 z" />
    <path
        android:fillColor="#00000000"
        android:pathData="M9.7,15.5 C10.3,14.9 11.1,14.5 12,14.5 C12.9,14.5 13.7,14.9 14.3,15.5"
        android:strokeColor="@color/status_icon_faint"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
    <path
        android:fillColor="#00000000"
        android:pathData="M6.4,12.2 C7.9,10.8 9.9,9.9 12,9.9 C14.1,9.9 16.1,10.8 17.6,12.2"
        android:strokeColor="@color/status_icon_faint"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />
    <path
        android:fillColor="#00000000"
        android:pathData="M3.1,8.9 C5.4,6.6 8.6,5.1 12,5.1 C15.4,5.1 18.6,6.6 20.9,8.9"
        android:strokeColor="@color/status_icon_faint"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="2.0" />

    <!-- 红叉：两条对角线，端点比图标外框各收 1.4，避免顶到 24dp 边缘被裁 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M5.4,5.4 L18.6,18.6"
        android:strokeColor="@color/status_icon_mark"
        android:strokeLineCap="round"
        android:strokeWidth="2.3" />
    <path
        android:fillColor="#00000000"
        android:pathData="M18.6,5.4 L5.4,18.6"
        android:strokeColor="@color/status_icon_mark"
        android:strokeLineCap="round"
        android:strokeWidth="2.3" />
</vector>
